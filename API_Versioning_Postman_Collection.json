							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"V3 login response is comprehensive\", function () {",
									"    var jsonData = pm.response.json();",
									"    var data = jsonData.data;",
									"    pm.expect(data).to.have.property(\"access_token\");",
									"    pm.expect(data).to.have.property(\"token_type\", \"Bearer\");",
									"    pm.expect(data).to.have.property(\"expires_in\");",
									"    pm.expect(data).to.have.property(\"scope\");",
									"    pm.expect(data).to.have.property(\"user\");",
									"    pm.expect(data).to.have.property(\"security\");",
									"    ",
									"    var user = data.user;",
									"    pm.expect(user).to.have.property(\"id\");",
									"    pm.expect(user).to.have.property(\"username\");",
									"    pm.expect(user).to.have.property(\"email\");",
									"    pm.expect(user).to.have.property(\"email_verified\");",
									"    pm.expect(user).to.have.property(\"roles\");",
									"    pm.expect(user).to.have.property(\"permissions\");",
									"    ",
									"    var security = data.security;",
									"    pm.expect(security).to.have.property(\"two_factor_enabled\");",
									"    pm.expect(security).to.have.property(\"active_sessions\");",
									"    pm.expect(security).to.have.property(\"login_attempts_today\");",
									"});",
