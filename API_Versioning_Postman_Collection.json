								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"V2 user response includes roles\", function () {",
									"    var jsonData = pm.response.json();",
									"    var user = jsonData.data;",
									"    pm.expect(user).to.have.property(\"id\");",
