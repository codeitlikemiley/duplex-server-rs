		{
			"name": "V1 API Tests (Deprecated)",
			"item": [
				{
					"name": "V1 Register User (Basic)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response includes deprecation headers\", function () {",
									"    pm.response.to.have.header(\"Deprecation\");",
									"    pm.response.to.have.header(\"Warning\");",
									"    pm.response.to.have.header(\"X-API-Version\");",
									"});",
									"",
									"pm.test(\"API version is V1\", function () {",
									"    pm.expect(pm.response.headers.get(\"X-API-Version\")).to.eql(\"v1\");",
									"});",
									"",
									"pm.test(\"Response contains versioned structure\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property(\"api_version\");",
									"    pm.expect(jsonData.api_version).to.eql(\"V1\");",
									"    pm.expect(jsonData).to.have.property(\"meta\");",
									"    pm.expect(jsonData.meta).to.have.property(\"deprecation_info\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{test_username}}_v1\",\n    \"email\": \"{{test_username}}_v1@example.com\",\n    \"password\": \"{{test_password}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "V1 Login User (Basic Response)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response contains basic V1 login structure\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property(\"token\");",
									"    pm.expect(jsonData.data).to.have.property(\"token_type\", \"Bearer\");",
									"    // V1 doesn't include user info or security details",
									"    pm.expect(jsonData.data).to.not.have.property(\"user\");",
									"    pm.expect(jsonData.data).to.not.have.property(\"security\");",
									"});",
									"",
									"// Save token for subsequent requests",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"access_token\", jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{test_username}}_v1@example.com\",\n    \"password\": \"{{test_password}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "V1 Get Profile (Basic Fields)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"V1 profile contains only basic fields\", function () {",
									"    var jsonData = pm.response.json();",
									"    var profile = jsonData.data;",
									"    pm.expect(profile).to.have.property(\"user_id\");",
									"    pm.expect(profile).to.have.property(\"first_name\");",
									"    pm.expect(profile).to.have.property(\"last_name\");",
									"    pm.expect(profile).to.have.property(\"email\");",
									"    // V1 doesn't include advanced fields",
									"    pm.expect(profile).to.not.have.property(\"bio\");",
									"    pm.expect(profile).to.not.have.property(\"location\");",
									"    pm.expect(profile).to.not.have.property(\"website\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/profile",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"profile"
							]
						}
					},
					"response": []
				}
			]
		},
