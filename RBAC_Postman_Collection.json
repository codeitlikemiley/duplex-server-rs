    {
      "name": "4. Manual Role Assignment (Database)",
      "item": [
        {
          "name": "Example SQL - Grant Admin Role",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "# Execute this SQL in your database to grant admin role to a user:\n# \n# -- First, find the user ID:\n# SELECT id, username, email FROM users WHERE email = 'testuser@example.com';\n# \n# -- Then assign admin role (replace USER_ID with actual ID):\n# INSERT INTO user_roles (user_id, role_id, assigned_at, assigned_by)\n# SELECT 'USER_ID', id, NOW(), 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'\n# FROM roles WHERE name = 'admin';\n# \n# -- Verify the assignment:\n# SELECT u.username, r.name as role_name, ur.assigned_at\n# FROM user_roles ur\n# JOIN users u ON ur.user_id = u.id  \n# JOIN roles r ON ur.role_id = r.id\n# WHERE u.email = 'testuser@example.com';",
              "host": ["# Execute this SQL in your database to grant admin role to a user:"],
              "path": [
                "# ",
                "# -- First, find the user ID:",
                "# SELECT id, username, email FROM users WHERE email = 'testuser@example.com';",
                "# ",
                "# -- Then assign admin role (replace USER_ID with actual ID):",
                "# INSERT INTO user_roles (user_id, role_id, assigned_at, assigned_by)",
                "# SELECT 'USER_ID', id, NOW(), 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'",
                "# FROM roles WHERE name = 'admin';",
                "# ",
                "# -- Verify the assignment:",
                "# SELECT u.username, r.name as role_name, ur.assigned_at",
                "# FROM user_roles ur",
                "# JOIN users u ON ur.user_id = u.id  ",
                "# JOIN roles r ON ur.role_id = r.id",
                "# WHERE u.email = 'testuser@example.com';"
              ]
            },
            "description": "This is not a real request - it's documentation for manual SQL commands to assign roles"
          }
        }
      ]
    },
    {
      "name": "5. Test Admin Operations (After Role Assignment)",
      "item": [
        {
          "name": "Get Rate Limit Stats (Should Work After Admin Role)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/rate-limits/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "rate-limits", "stats"]
            }
          }
        },
        {
          "name": "Get Lockout Statistics (Should Work After Admin Role)",
          "request": {
            "method": "GET",
