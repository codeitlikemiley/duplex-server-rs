          }
        },
        {
          "name": "Lock User Account (Admin Function)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lockout_type\": \"Temporary\",\n  \"reason\": \"Testing admin lockout functionality\",\n  \"duration_hours\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/users/{{user_id}}/lock",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users", "{{user_id}}", "lock"]
            }
          }
        }
      ]
    },
    {
      "name": "6. RBAC Database Queries",
      "item": [
        {
          "name": "Database Query Examples",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "# Useful database queries for testing RBAC:\n# \n# -- Check all roles:\n# SELECT * FROM roles ORDER BY is_system DESC, name;\n# \n# -- Check all permissions:\n# SELECT * FROM permissions ORDER BY resource, action;\n# \n# -- Check user roles:\n# SELECT u.username, u.email, r.name as role, ur.assigned_at\n# FROM user_roles ur\n# JOIN users u ON ur.user_id = u.id\n# JOIN roles r ON ur.role_id = r.id\n# ORDER BY u.username, r.name;\n# \n# -- Check role permissions:\n# SELECT r.name as role, p.resource, p.action, p.description\n# FROM role_permissions rp\n# JOIN roles r ON rp.role_id = r.id\n# JOIN permissions p ON rp.permission_id = p.id\n# ORDER BY r.name, p.resource, p.action;\n# \n# -- Test permission function:\n# SELECT user_has_permission('USER_ID_HERE', 'admin', 'access');\n# \n# -- Get user permissions:\n# SELECT * FROM get_user_permissions('USER_ID_HERE');",
              "host": ["# Useful database queries for testing RBAC:"],
              "path": [
                "# ",
                "# -- Check all roles:",
                "# SELECT * FROM roles ORDER BY is_system DESC, name;",
                "# ",
                "# -- Check all permissions:",
                "# SELECT * FROM permissions ORDER BY resource, action;",
                "# ",
                "# -- Check user roles:",
                "# SELECT u.username, u.email, r.name as role, ur.assigned_at",
                "# FROM user_roles ur",
                "# JOIN users u ON ur.user_id = u.id",
                "# JOIN roles r ON ur.role_id = r.id",
                "# ORDER BY u.username, r.name;",
                "# ",
                "# -- Check role permissions:",
                "# SELECT r.name as role, p.resource, p.action, p.description",
                "# FROM role_permissions rp",
                "# JOIN roles r ON rp.role_id = r.id",
                "# JOIN permissions p ON rp.permission_id = p.id",
                "# ORDER BY r.name, p.resource, p.action;",
                "# ",
                "# -- Test permission function:",
                "# SELECT user_has_permission('USER_ID_HERE', 'admin', 'access');",
                "# ",
                "# -- Get user permissions:",
                "# SELECT * FROM get_user_permissions('USER_ID_HERE');"
              ]
            },
            "description": "Database queries to inspect and test the RBAC system"
          }
        }
      ]
    },
    {
