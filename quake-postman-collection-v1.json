            "url": {
              "raw": "{{baseUrl}}/api/permissions/check",
              "host": ["{{baseUrl}}"],
              "path": ["api", "permissions", "check"]
            },
            "description": "Check if current user has a specific permission"
          }
        }
      ]
    },
