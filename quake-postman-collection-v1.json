            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{userId}}/lock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{userId}}", "lock"]
            },
            "description": "Lock a user account for security reasons"
          }
        },
        {
          "name": "Unlock User Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{userId}}/unlock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{userId}}", "unlock"]
            },
            "description": "Unlock a locked user account"
          }
        },
        {
          "name": "Bulk Delete Users",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_ids\": [\"uuid1\", \"uuid2\", \"uuid3\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/bulk-delete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "bulk-delete"]
            },
            "description": "Delete multiple users at once"
          }
        }
      ]
    },
    {
      "name": "6. RBAC (Roles & Permissions)",
